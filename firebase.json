{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "scripts/**", "*.md", "firestore.rules", "storage.rules"],
    "headers": [
      { "source": "admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
      { "source": "**/*.@(jpg|png|svg|mp4|webp|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] }
    ]
  }
}
