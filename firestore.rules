rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Core Expertise: anyone can read published items; only admins can read drafts or write
    match /expertise/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 260;
      allow delete: if isAdmin();
    }
    // Admin allow-list: managed only from the Firebase console
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
